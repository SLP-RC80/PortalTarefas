
@model IReadOnlyList<Tarefa>

@{
    ViewData["Title"] = "Minhas Tarefas";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold">Minhas Tarefas</h2>
        <p class="text-muted mb-0">
            Gerencie suas atividades e compromissos.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Nova Tarefa
    </a>

</div>

@await Component.InvokeAsync("TarefasVencidas")
@if (TempData["Mensagem"] is string mensagem)
{
    <div class="alert alert-success alert-dismissible fade show">
        @mensagem

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<div class="card shadow-sm border-0">

    <div class="card-body">

        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <h5>Nenhuma tarefa cadastrada.</h5>
                <p class="text-muted">
                    Clique em Nova Tarefa para começar.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Tarefa</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

<tbody>

    @foreach (var tarefa in Model)
    {
        <tr>

            <td>
                <partial name="_TarefaResumo"
                         model="tarefa" />
            </td>

            <td class="text-end">

                <a asp-action="Details"
                   asp-route-id="@tarefa.Id"
                   class="btn btn-sm btn-outline-primary">
                    Detalhes
                </a>

                <a asp-action="Edit"
                   asp-route-id="@tarefa.Id"
                   class="btn btn-sm btn-outline-secondary">
                    Editar
                </a>

            </td>

        </tr>
    }

</tbody>

                </table>

            </div>
        }

    </div>
</div>

<div class="mt-3 text-muted small">
    Total de tarefas cadastradas: @Model.Count
</div>
